# ==============================================================================
# ExamPlatform - Environment Configuration Template (.env.example)
# Copy this file to .env.local for local development.
# WARNING: NEVER commit .env.local or real secrets to Version Control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Public Client-Side Configuration (Safe for browser bundle)
# ------------------------------------------------------------------------------
# Supabase Public URL and Anonymous Public Key
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_public_key_here

# Application Base URL (for redirects, auth callbacks, and metadata)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 2. Server-Only Supabase Credentials (CRITICAL: NEVER expose to client components)
# ------------------------------------------------------------------------------
# Supabase Service Role Key (used for administrative tasks, bypasses RLS)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Direct Database Connection (for migrations and administrative queries)
# Format: postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL=
DIRECT_URL=
SUPABASE_DB_PASSWORD=

# ------------------------------------------------------------------------------
# 3. AI Question Generation Pipeline Configuration (Server-Only)
# ------------------------------------------------------------------------------
# OpenAI or compatible LLM provider API key
AI_API_KEY=your_ai_provider_api_key_here
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# ------------------------------------------------------------------------------
# 4. Optional Authentication & Deployment Providers
# ------------------------------------------------------------------------------
# Google OAuth (Optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Vercel Deployment (Managed via Vercel Dashboard / CLI, not in repo)
# VERCEL_TOKEN=
